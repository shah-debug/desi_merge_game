# Normalize line endings for text files
* text=auto

# Unity YAML assets
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.meta text eol=lf
*.mat text eol=lf
*.anim text eol=lf
*.controller text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.psd binary
*.aseprite binary
*.wav binary
*.mp3 binary
*.ogg binary
*.ttf binary
*.otf binary
*.fbx binary
*.dll binary
*.so binary
*.aar binary
*.jar binary
